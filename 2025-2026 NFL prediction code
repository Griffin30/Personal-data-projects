Step 7: Creating a strength variable to use for the modeling
```{r}
logit_model_1 <- glm(
  win ~ sacks_suffered + turnovers + forced_turnovers +  rushing_epa + passing_epa + def_tackles_for_loss + def_sacks + penalties,
  data = NFL_2025_playoff_teams,
  family = binomial
)

summary(logit_model_1)

NFL_2025_playoff_teams$win_pct <- NFL_2025_playoff_teams$win

NFL_2025_playoff_teams$win_pct <- predict(logit_model_1, type = "response")


team_strength <- NFL_2025_playoff_teams %>%
  group_by(team) %>%
  summarise(
    strength = mean(win_pct, na.rm = TRUE),
    win_pct = mean(win),
    wins = sum(win)
  ) %>%
  arrange(desc(strength))
```

Step 8: Creating the sim and running the wild card round to determine the divisional round
```{r}
sim_game <- function(team_a, team_b, team_strength) {
  prob_a = team_strength$strength[team_strength$team == team_a]
  prob_b = team_strength$strength[team_strength$team == team_b]
  
  win_prob_a = ((prob_a) - (prob_a * prob_b))/((prob_a + prob_b) - (2 * (prob_a * prob_b)))
  
  if (runif(1) < win_prob_a) return(team_a) else return(team_b)
}

  runsim_wc <- function(team_strength) {
    afc_wc1 <- sim_game("NE", "LAC", team_strength)
    afc_wc2 <- sim_game("JAX", "BUF", team_strength)
    afc_wc3 <- sim_game("HOU", "PIT", team_strength)
    
    nfc_wc1 <- sim_game("CHI", "GB", team_strength)
    nfc_wc2 <- sim_game("PHI", "SF", team_strength)
    nfc_wc3 <- sim_game("LA", "CAR", team_strength)
    
    
    return(c(afc_wc1, afc_wc2, afc_wc3, nfc_wc1, nfc_wc2, nfc_wc3))
  }
  
set.seed(123)
wc_results <- replicate(10000, runsim_wc(team_strength))

all_wc_winners <- as.vector(wc_results)

wc_odds <- as.data.frame(table(all_wc_winners)) %>% 
  rename(team = all_wc_winners, wins = Freq) %>%
  mutate(win_prob = wins / 10000) %>%
  arrange(desc(win_prob))
```

Step 9: running the divisional round to determine the championship round
```{r}

runsim_dv <- function(team_strength) {
    afc_dv1 <- sim_game("NE", "PIT", team_strength)
    afc_dv2 <- sim_game("DEN", "BUF", team_strength)
    
    nfc_dv1 <- sim_game("CHI", "PHI", team_strength)
    nfc_dv2 <- sim_game("SEA", "LA", team_strength)
    
    
    return(c(afc_dv1, afc_dv2, nfc_dv1, nfc_dv2))
  }
  
set.seed(123)
dv_results <- replicate(10000, runsim_dv(team_strength))

all_dv_winners <- as.vector(dv_results)

dv_odds <- as.data.frame(table(all_dv_winners)) %>% 
  rename(team = all_dv_winners, wins = Freq) %>%
  mutate(win_prob = wins / 10000) %>%
  arrange(desc(win_prob))
```

Step 10: running the championship games to determine the superbowl
```{r}

runsim_ch <- function(team_strength) {
    afc_ch <- sim_game("NE", "DEN", team_strength)
    nfc_ch <- sim_game("LA", "CHI", team_strength)
   
    return(c(afc_ch, nfc_ch))
  }
  
set.seed(123)
ch_results <- replicate(10000, runsim_ch(team_strength))

all_ch_winners <- as.vector(ch_results)

ch_odds <- as.data.frame(table(all_ch_winners)) %>% 
  rename(team = all_ch_winners, wins = Freq) %>%
  mutate(win_prob = wins / 10000) %>%
  arrange(desc(win_prob))
```


```{r}

runsim_sb <- function(team_strength) {
