Trying to predict a superbowl winner using NFL stats from the 2025 season

Step 1: adding a win column to 2025 dataset.
```{r warning=FALSE}
 other_dataset <- load_schedules(2025) %>% 
  filter(week <= 18) %>% 
  select(season, week, home_team, away_team, home_score, away_score)

 win_condition <- other_dataset %>% 
   pivot_longer(
    cols = c(home_team, away_team),
    names_to = "home_away",
    values_to = "team"
  ) %>% 
  mutate(
    win = case_when(
      home_away == "home_team" & home_score > away_score ~ 1,
      home_away == "away_team" & away_score > home_score ~ 1,
      TRUE ~ 0
    )
  ) %>% 
  select(season, week, team, win)


NFL_full_stats <- load_team_stats(2025) %>% 
  left_join(win_condition, by = c("season", "week", "team")) %>% 
  relocate(win, .after = "team")

```


Step 2: creating a dataset strictly with 2025 nfl playoff teams and optimizing variables
```{r warning=FALSE}
NFL_2025_team_stats <- NFL_full_stats %>%
  filter(season_type == "REG") %>% 
  mutate(comp_perc = completions/attempts, 
  turnovers = passing_interceptions + sack_fumbles_lost + rushing_fumbles_lost + receiving_fumbles_lost,
  forced_turnovers = def_interceptions + fumble_recovery_opp,
  rypa = rushing_yards / carries, ##rypa = rushing yards per attempt
  total_tackles = def_tackles_solo + def_tackles_with_assist + def_tackle_assists) %>% 
  select(season, week, team, opponent_team, comp_perc, passing_yards, passing_tds, sacks_suffered,        turnovers, forced_turnovers, rypa, rushing_tds, rushing_epa, passing_epa, receiving_epa,                total_tackles, def_tackles_for_loss, def_sacks, def_qb_hits, def_pass_defended, penalties,              penalty_yards, fg_pct, win)

playoffteams <- c("BUF", "CAR", "SEA", "LA", "LAC", "PIT", "NE", "DEN", "JAX", "HOU", "SF", "GB", "PHI", "CHI")

NFL_2025_playoff_teams <- NFL_2025_team_stats %>% 
  filter(team %in% playoffteams)

```
**I took the playoff teams of 2025 and filtered all of their 17 games of the season while adding parameters that I think will be usefully in predicting playoff success.**

